{
    "name": "wintrchess",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:server && npm run build:client",
        "build:client": "webpack",
        "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json -f",
        "check": "tsc --noEmit",
